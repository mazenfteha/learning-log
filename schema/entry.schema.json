{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Log entry",
  "description": "One lesson from one coding task. Written by the /log skill, saved by scripts/store.py. Count limits on decisions, questions and quiz apply to each /log run; a stored entry merged over several runs may hold more.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "decisions", "questions", "quiz"],
  "properties": {
    "schema_version": {
      "description": "Version of this contract. Bump it only with a migration in store.py.",
      "const": 1
    },
    "task": { "$ref": "#/$defs/task" },
    "decisions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/decision" }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/question" }
    },
    "quiz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/quiz_item" }
    },
    "review": { "$ref": "#/$defs/review" },
    "code": { "$ref": "#/$defs/code" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 date-time, e.g. 2026-10-21T14:05:00+00:00"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "project", "stack", "layers", "risk",
        "how_it_works", "surprised_me", "would_bite_again"
      ],
      "properties": {
        "id": {
          "description": "Ticket ID if there is one (PROJ-123, gh-42), otherwise <project>-<YYYYMMDD>-<short-slug>. Used as the file name.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "title": {
          "description": "The task in plain words.",
          "allOf": [{ "$ref": "#/$defs/text" }],
          "maxLength": 120
        },
        "project": {
          "description": "Lowercase project slug. Used as the directory name.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "repo": {
          "description": "Remote URL without credentials, or the repository directory name.",
          "type": ["string", "null"]
        },
        "branch": {
          "type": ["string", "null"]
        },
        "stack": {
          "description": "Languages and frameworks touched.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["business_logic", "code", "architecture", "stack"] }
        },
        "risk": {
          "description": "high for auth, payments, migrations, infrastructure, data deletion.",
          "enum": ["low", "medium", "high"]
        },
        "how_it_works": {
          "description": "2 to 4 sentences on the mechanism, not the diff.",
          "allOf": [{ "$ref": "#/$defs/text" }],
          "maxLength": 900
        },
        "surprised_me": {
          "description": "The non-obvious part, 1 to 2 sentences.",
          "allOf": [{ "$ref": "#/$defs/text" }],
          "maxLength": 400
        },
        "would_bite_again": {
          "description": "The trap to watch for next time, 1 to 2 sentences.",
          "allOf": [{ "$ref": "#/$defs/text" }],
          "maxLength": 400
        },
        "created_at": { "$ref": "#/$defs/datetime" },
        "updated_at": { "$ref": "#/$defs/datetime" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "chosen", "rejected", "why", "kind", "reversible", "files"],
      "properties": {
        "title": {
          "allOf": [{ "$ref": "#/$defs/text" }],
          "maxLength": 120
        },
        "chosen": { "$ref": "#/$defs/text" },
        "rejected": {
          "description": "Real alternatives that were considered and not used.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "why": { "$ref": "#/$defs/text" },
        "kind": {
          "enum": ["product", "architecture", "security", "workaround", "deferred", "process"]
        },
        "reversible": { "type": "boolean" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "impact": {
          "description": "The consequence to live with, if any.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asked", "should_have_asked", "rating", "feedback"],
      "properties": {
        "asked": { "$ref": "#/$defs/text" },
        "should_have_asked": { "$ref": "#/$defs/text" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "feedback": { "$ref": "#/$defs/text" }
      }
    },
    "quiz_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "answer", "file"],
      "properties": {
        "type": { "enum": ["predict", "why", "where", "trap"] },
        "question": { "$ref": "#/$defs/text" },
        "answer": {
          "description": "1 to 3 sentences.",
          "allOf": [{ "$ref": "#/$defs/text" }],
          "maxLength": 500
        },
        "file": {
          "description": "The path that proves the answer.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "review": {
      "description": "Managed by store.py. The skill never writes it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["due", "interval_days", "last_reviewed", "times_reviewed"],
      "properties": {
        "due": { "$ref": "#/$defs/date" },
        "interval_days": { "type": "integer", "minimum": 1 },
        "last_reviewed": {
          "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
        },
        "times_reviewed": { "type": "integer", "minimum": 0 }
      }
    },
    "code": {
      "description": "One short before/after snippet, under 10 lines each.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "before", "after"],
      "properties": {
        "file": { "$ref": "#/$defs/text" },
        "before": {
          "type": "string",
          "pattern": "^[^\\n]*(\\n[^\\n]*){0,9}$"
        },
        "after": {
          "type": "string",
          "pattern": "^[^\\n]*(\\n[^\\n]*){0,9}$"
        },
        "note": { "$ref": "#/$defs/text" }
      }
    }
  }
}
